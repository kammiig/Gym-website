# Optional contact form forwarding.
# If set, /api/contact will POST validated contact submissions to this URL.
CONTACT_WEBHOOK_URL=

# Optional custom endpoint for the frontend contact form.
# Leave empty to use the included Next.js /api/contact route.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Support portal email.
# Recommended production option: Resend.
RESEND_API_KEY=
RESEND_FROM="Planetic Solutions Support <support@planeticsolution.com>"
SUPPORT_EMAIL=kammiig@gmail.com
SUPPORT_AUTH_SECRET=replace-with-a-long-random-secret

# Optional fallback: Gmail SMTP.
# For Gmail, use an App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kammiig@gmail.com
SMTP_PASS=
SMTP_FROM="Planetic Solutions Support <kammiig@gmail.com>"
